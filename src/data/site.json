  "problem": {
    "label": "The Problem",
    "title": ["Every system in your company is right", "That is the problem"],
    "image": {
      "src": "/src/assets/images/veryti-main-img.webp",
      "alt": ""
    },
    "timeline": [
      {
        "type": "statement",
        "nodeId": "285:451",
        "text": "Ask what a customer is worth, what a supplier truly costs, or whether a production line should continue—and you’ll get multiple answers. Each is valid within its own system. None is authoritative across the enterprise."
      },
      {
        "type": "statement",
        "nodeId": "285:580",
        "text": "So the decision takes time — for reconciliation, for alignment, for a version of the truth everyone will sign. When it is finally taken, it is defended in a hard to reconstruct spreadsheet, and reopened the moment someone asks who approved it."
      },
      {
        "type": "costs",
        "nodeId": "285:667",
        "intro": "That is the cost you are already paying:",
        "items": [
          {
            "highlight": "Capital allocated once a year",
            "text": ", because continuous reallocation cannot be defended."
          },
          {
            "highlight": "Decisions taken at the speed of reconciliation",
            "text": ", not at the speed of the market."
          },
          {
            "highlight": "Evidence assembled after the fact",
            "text": ", at audit cost, from systems that were never asked to remember."
          }
        ]
      },
      {
        "type": "statement",
        "nodeId": "285:712",
        "text": "The interfaces are connected. What is missing sits beneath them: what each record means, which version applied at the moment it mattered, who owns it, what it is worth for this decision, who may decide, and what may then happen."
      }
    ],
    "principles": {
      "nodeId": "285:795",
      "items": [
        "Entities change.",
        "Schemas change.",
        "What happened does not."
      ]
    },
