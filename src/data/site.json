  "hero": {
    "eyebrow": "Enterprise Decision Infrastructure",
    "title": ["Tokenize every asset.", "Optimize the entire enterprise."],
    "description": "Verity gives every asset — line item, contract, machine, and model — a governed identity and a value specific to the decision at hand. So you reallocate capital continuously instead of annually, and every reallocation can be verified independently.",
