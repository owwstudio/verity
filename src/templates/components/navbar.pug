mixin navbarSimpleDropdown(name, label, config)
  - const menuId = `navbar-${name}-menu`
  li.navbar__item.navbar__item--dropdown(
    data-navbar-dropdown=name,
    data-state='closed'
  )
    button.navbar__link.navbar__dropdown-toggle(
      type='button',
      aria-expanded='false',
      aria-controls=menuId,
      aria-haspopup='true',
      data-navbar-dropdown-toggle
    )
      span= label
      span.navbar__dropdown-caret(aria-hidden='true')
        img(
          src='/src/assets/icons/caret-down.svg',
          alt='',
          width='16',
          height='16'
        )
    .navbar__dropdown(
      id=menuId,
      class=`navbar__dropdown--${name}`,
      aria-hidden='true',
      inert,
      data-navbar-dropdown-menu,
      data-node-id=config.nodeId
    )
      span.navbar__ribbon= navbar.ribbon
      ul.navbar__dropdown-list
        each item in config.items
          li.navbar__dropdown-item
            if item.href
              a.navbar__dropdown-link(href=item.href)= item.label
            else
              span.navbar__dropdown-link.navbar__dropdown-link--pending(
                aria-disabled='true'
              )= item.label

mixin navbar
  nav.navbar(
    aria-label='Primary navigation',
    data-navbar,
    data-state='closed',
    data-navbar-position='fixed',
    data-node-id='278:35'
  )
    a.navbar__brand(href='/', aria-label=navbar.brand.label, data-navbar-logo)
      img.navbar__mark(src=navbar.brand.mark, alt='', width='85', height='94')
      span.navbar__wordmark= navbar.brand.wordmark

    button.navbar__mobile-toggle(
      type='button',
      aria-label='Open navigation menu',
      aria-expanded='false',
      aria-controls='navbar-menu',
      data-navbar-mobile-toggle
    )
      img.navbar__mobile-toggle-icon.navbar__mobile-toggle-icon--open(
        src='/src/assets/icons/list.svg',
        alt='',
        width='24',
        height='24'
      )
      img.navbar__mobile-toggle-icon.navbar__mobile-toggle-icon--close(
        src='/src/assets/icons/close.svg',
        alt='',
        width='24',
        height='24'
      )

    #navbar-menu.navbar__panel(data-navbar-panel)
      ul.navbar__menu(data-navbar-primary)
        li.navbar__item.navbar__item--assessment
          a.navbar__link(href='/assessment/') Assessment
        +navbarSimpleDropdown('product', 'Product', navbar.product)
        li.navbar__item.navbar__item--dropdown(
          data-navbar-dropdown='solutions',
          data-state='closed'
        )
          button.navbar__link.navbar__dropdown-toggle(
            type='button',
            aria-expanded='false',
            aria-controls='navbar-solutions-menu',
            aria-haspopup='true',
            data-navbar-dropdown-toggle
          )
            span Solutions
            span.navbar__dropdown-caret(aria-hidden='true')
              img(
                src='/src/assets/icons/caret-down.svg',
                alt='',
                width='16',
                height='16'
              )
          #navbar-solutions-menu.navbar__dropdown.navbar__dropdown--solutions(
            aria-hidden='true',
            inert,
            data-navbar-dropdown-menu,
            data-node-id=navbar.solutions.nodeId
          )
            span.navbar__ribbon= navbar.ribbon
            each group in navbar.solutions.groups
              .navbar__dropdown-group
                if group.label
                  p.navbar__dropdown-heading= group.label
                ul.navbar__dropdown-list
                  each item in group.items
                    li.navbar__dropdown-item
                      if item.href
                        a.navbar__dropdown-link(href=item.href)= item.label
                      else
                        span.navbar__dropdown-link.navbar__dropdown-link--pending(
                          aria-disabled='true'
                        )= item.label
        li.navbar__item
          a.navbar__link(href='/assurance/') Assurance

      .navbar__actions
        ul.navbar__menu.navbar__menu--secondary
          +navbarSimpleDropdown('company', 'Company', navbar.company)
          +navbarSimpleDropdown('how-it-works', 'How it works', navbar.howItWorks)

        .navbar__controls
          +button(navbar.action.label, navbar.action.href, 'primary').navbar__cta.button--compact(
            data-navbar-cta
          )
