footer#site-footer.site-footer(data-site-footer, data-node-id=siteFooter.nodeId)
  .site-footer__inner
    .site-footer__lead
      a.site-footer__signature(
        href=siteFooter.signature.href,
        aria-label=siteFooter.signature.label,
        data-footer-wordmark
      )
        img.site-footer__mark(
          src=siteFooter.signature.mark,
          alt='',
          width='85',
          height='94',
          loading='lazy',
          decoding='async'
        )
        span.site-footer__brand= siteFooter.signature.wordmark

      ul.site-footer__lead-links(data-footer-reveal)
        each item in siteFooter.leadLinks
          li.site-footer__lead-item
            a.site-footer__link(href=item.href)= item.label

      a.site-footer__cta(href=siteFooter.action.href, data-footer-reveal)= siteFooter.action.label

    nav.site-footer__menus(aria-label='Footer navigation')
      each menu in siteFooter.menus
        .site-footer__menu(data-footer-reveal)
          h2.site-footer__group-name= menu.name
          ul.site-footer__list
            each entry in menu.entries
              li.site-footer__item
                if entry.href
                  a.site-footer__link(href=entry.href)= entry.label
                else
                  span.site-footer__pending(aria-disabled='true')
                    | #{ entry.label }
                    span.site-footer__pending-note — coming soon

    .site-footer__company
      address.site-footer__address(data-footer-reveal)
        strong.site-footer__company-name= siteFooter.company.name
        each line in siteFooter.company.address
          span.site-footer__address-line= line

      .site-footer__contact(data-footer-reveal)
        p.site-footer__contact-details
          a.site-footer__company-link(href=siteFooter.company.email.href)= siteFooter.company.email.label
          a.site-footer__company-link(href=siteFooter.company.phone.href)= siteFooter.company.phone.label

        ul.site-footer__legal
          each item in siteFooter.company.legal
            li.site-footer__legal-item
              a.site-footer__company-link(href=item.href)= item.label

      ul.site-footer__offices(data-footer-reveal)
        each office in siteFooter.company.offices
          li.site-footer__office= office.name

      figure.site-footer__map(data-footer-reveal)
        img.site-footer__map-image(
          src=siteFooter.company.map,
          alt='',
          width='1000',
          height='389',
          loading='lazy',
          decoding='async'
        )
        svg.site-footer__marks(viewBox='0 0 1000 389', aria-hidden='true')
          each office in siteFooter.company.offices
            circle(cx=office.x, cy=office.y, r='7')
        figcaption.site-footer__pending-note= siteFooter.company.mapAlt
