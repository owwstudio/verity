section.decision-flow(
  aria-labelledby='decision-flow-title',
  data-decision-flow,
  data-node-id=decisionFlow.nodeId
)
  .decision-flow__sticky(data-decision-flow-sticky)
    .decision-flow__panel
      .decision-flow__backdrop(aria-hidden='true', data-decision-flow-backdrop)

      .decision-flow__header(data-decision-flow-header)
        .decision-flow__heading
          p.decision-flow__eyebrow(data-decision-flow-reveal)= decisionFlow.eyebrow
          h2#decision-flow-title.decision-flow__title(
            data-decision-flow-reveal
          )= decisionFlow.title

        p.decision-flow__description(data-decision-flow-reveal)= decisionFlow.description

      .decision-flow__divider(data-decision-flow-divider)

      .decision-flow__content(data-decision-flow-content)
        .decision-flow__rail
          ol.decision-flow__steps
            each step, index in decisionFlow.steps
              li.decision-flow__step(
                data-state=index === 0 ? 'active' : 'inactive',
                data-decision-flow-step,
                data-decision-flow-reveal
              )
                button.decision-flow__trigger(
                  type='button',
                  aria-expanded=index === 0 ? 'true' : 'false',
                  aria-controls=step.id,
                  data-decision-flow-trigger
                )
                  span.decision-flow__summary
                    strong.decision-flow__step-label= step.label
                    span.decision-flow__icon(aria-hidden='true')
                      img(
                        src='/src/assets/icons/plus-circle.svg',
                        alt='',
                        width='24',
                        height='24'
                      )

                .decision-flow__step-details(
                  id=step.id,
                  aria-hidden=index === 0 ? 'false' : 'true',
                  data-decision-flow-details
                )
                  .decision-flow__step-details-inner
                    p= step.description

          .decision-flow__evidence(
            data-node-id=decisionFlow.evidence.nodeId,
            data-decision-flow-evidence
          )
            button.decision-flow__evidence-preview(
              type='button',
              aria-label='View evidence slide',
              data-decision-flow-evidence-preview
            )
              img(
                src='/src/assets/icons/arrow-circle-right.svg',
                alt='',
                width='38',
                height='38'
              )
            p.decision-flow__evidence-copy(data-decision-flow-reveal)= decisionFlow.evidence.text
            +button(decisionFlow.evidence.action.label, decisionFlow.evidence.action.href, 'inverse', decisionFlow.evidence.action.icon).button--with-icon(
              data-decision-flow-reveal
            )

        figure.decision-flow__media(data-decision-flow-media)
          video.decision-flow__video(
            muted,
            playsinline,
            preload='none',
            poster=decisionFlow.video.poster,
            role='img',
            aria-label=decisionFlow.video.alt,
            data-decision-flow-video
          )
            source(
              src=decisionFlow.video.webm,
              type='video/webm',
              data-decision-flow-video-webm
            )
            source(
              src=decisionFlow.video.mov,
              type='video/quicktime; codecs=hvc1',
              data-decision-flow-video-mov
            )

      .decision-flow__mobile-progress(
        role='progressbar',
        aria-label='Decision flow progress',
        aria-valuemin='0',
        aria-valuemax='100',
        aria-valuenow='0',
        data-decision-flow-progress
      )
        span.decision-flow__mobile-progress-track
          span.decision-flow__mobile-progress-bar(
            data-decision-flow-progress-bar
          )
