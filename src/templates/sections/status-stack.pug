section.status-stack(
  aria-labelledby='status-stack-title',
  data-status-stack,
  data-node-id=statusStack.nodeId
)
  .status-stack__sticky(data-status-stack-sticky)
    .status-stack__panel(data-status-stack-panel)
      img.status-stack__background-accent(
        src=statusStack.background.accent,
        alt='',
        width='473',
        height='1024',
        loading='lazy',
        decoding='async'
      )
      .status-stack__background-anchor(aria-hidden='true')
        img.status-stack__background(
          src=statusStack.background.src,
          alt='',
          width='4096',
          height='2731',
          loading='lazy',
          decoding='async',
          data-status-stack-background
        )

      header.status-stack__header
        p.status-stack__eyebrow= statusStack.eyebrow
        h2#status-stack-title.status-stack__title= statusStack.title

      .status-stack__cards
        each card, index in statusStack.cards
          article.status-stack__card(
            data-status-stack-card,
            data-card-index=index
          )
            .status-stack__card-visual
              span.status-stack__number= card.number
              img.status-stack__icon(
                src=card.icon,
                alt='',
                loading='lazy',
                decoding='async'
              )

            .status-stack__card-copy
              h3.status-stack__card-title= card.title

              if card.roadmap
                ol.status-stack__roadmap
                  each milestone in card.roadmap
                    li.status-stack__milestone
                      strong= milestone.title
                      span= milestone.detail
              else
                if card.mark
                  p.status-stack__mark= card.mark
                p.status-stack__card-text= card.text
                if card.note
                  p.status-stack__card-note= card.note

      a.status-stack__action(
        href=statusStack.action.href,
        data-status-stack-action
      )
        span= statusStack.action.label
        img.status-stack__action-icon(
          src='/src/assets/icons/status-arrow.png',
          alt='',
          width='24',
          height='21',
          aria-hidden='true'
        )
