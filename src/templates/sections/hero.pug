section.hero(aria-labelledby='hero-title', data-hero, data-node-id='285:86')
  .container.hero__content
    .hero__lead
      .hero__heading
        +tag(hero.eyebrow, 'outline')(data-hero-eyebrow)

        h1#hero-title.hero__title(data-hero-title)
          each line, index in hero.title
            span.hero__title-line(class=index === 0 ? 'hero__title-line--muted' : '')= line

      ul.hero__platforms(
        aria-label='Supported cloud platforms',
        data-hero-tags
      )
        each platform in hero.platforms
          li.hero__platform
            +tag(platform, 'muted')

    .hero__aside
      p.hero__description= hero.description

      .hero__actions
        +button(hero.primaryAction.label, hero.primaryAction.href, 'primary', '/src/assets/icons/arrow-circle-right.svg').button--with-icon(
          data-hero-primary-action
        )
        +button(hero.secondaryAction.label, hero.secondaryAction.href, 'secondary')(
          data-hero-secondary-action
        )
